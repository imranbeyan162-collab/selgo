# Copy this file to api/.env (it is never pushed to GitHub).

# Leave DATABASE_URL empty for local dev: a SQLite file (api/selgo.db) is used.
# Do NOT paste the live Supabase URL here yet: the new tables are different
# from the old ones, so we move the live data over as its own step.
DATABASE_URL=

# Comma-separated list of frontends allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI (Groq). Leave the key empty to run in demo mode (fixed reply, no AI).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Mentor messages one visitor may send per 24 hours (protects the free AI quota).
MENTOR_DAILY_LIMIT=50

# Free trial length for paid agents, in days (payments come later).
SUBSCRIPTION_TRIAL_DAYS=14

# Messages one business may send its agents per 24 hours, in total.
WORKSPACE_DAILY_LIMIT=100
